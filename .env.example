# ============================================
# 积分商城系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置：
#   cp .env.example .env
# ============================================

# ---- 端口配置 ----
# 前端访问端口（默认 80）
FRONTEND_PORT=18781
# 移动端访问端口（默认 80）
FRONTENMOBILE_PORTD_PORT=18782

# 后端 API 端口（默认 18780）
BACKEND_PORT=18780

# MySQL 外部访问端口（默认 3307，避免与本地 MySQL 3306 冲突）
MYSQL_PORT=3307

# ---- 数据库配置 ----
# MySQL root 密码
MYSQL_PASSWORD=root123

# ---- JWT 配置 ----
# JWT 签名密钥（生产环境请使用复杂随机字符串）
JWT_SECRET=ai-shop-jwt-secret-for-docker-2026
